# .env.example - Production Environment Variables Template
ENVIRONMENT=PRODUCTION
APP_NAME=Vendor Bank-Change Fraud Guardian
APP_VERSION=1.1.0

# Database & Supabase Configuration (Set in Cloud Dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
JWT_SECRET_KEY=your-secure-jwt-secret-key

# Production CORS Allowed Origins
ALLOWED_ORIGINS=https://app.fraudguardian.internal,https://console.fraudguardian.internal

# Email / SMS Provider Secrets
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-smtp-api-key
SMTP_FROM_EMAIL=security@fraudguardian.internal
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_PHONE=+15005550006

# Anti-Storm Settings
ALERT_SUPPRESSION_WINDOW_SEC=300
